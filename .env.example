# ==========================================
# Ronak Video Editor Portfolio — Environment
# Copy values into backend/.env and frontend/.env
# Never commit real .env files to Git
# ==========================================

# --- Backend Configuration ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB Atlas or Local MongoDB) ---
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ronak_portfolio?retryWrites=true&w=majority

# --- Authentication (JWT & HTTP-only Cookies) ---
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=ronak_auth_token

# --- Initial Admin Seeding (Read by backend/scripts/seedAdmin.js) ---
ADMIN_SEED_NAME=Ronak
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_this_strong_password

# --- Media Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Frontend Configuration (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api
